{
  "properties": {
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "When_a_product_is_added": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "subscriptionRequest/message": 1,
              "subscriptionRequest/entityname": "lab_product",
              "subscriptionRequest/scope": 4
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "actions": {
        "Has_barcode": {
          "type": "If",
          "expression": {
            "not": {
              "equals": [
                "@coalesce(triggerOutputs()?['body/lab_ean'], '')",
                ""
              ]
            }
          },
          "actions": {
            "Get_product_by_barcode": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "lab_connectorsopenfoodfacts",
                  "operationId": "GetProductByBarcode",
                  "apiId": "/providers/Microsoft.PowerApps/apis/lab_connectorsopenfoodfacts"
                },
                "parameters": {
                  "barcode": "@triggerOutputs()?['body/lab_ean']"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            },
            "Update_the_product": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "UpdateOnlyRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "lab_products",
                  "recordId": "@triggerOutputs()?['body/lab_productid']",
                  "item/lab_name": "@coalesce(outputs('Get_product_by_barcode')?['body/name'], triggerOutputs()?['body/lab_name'])",
                  "item/lab_brand": "@outputs('Get_product_by_barcode')?['body/brand']",
                  "item/lab_quantity": "@outputs('Get_product_by_barcode')?['body/quantity']",
                  "item/lab_imageurl": "@outputs('Get_product_by_barcode')?['body/imageUrl']",
                  "item/lab_lastsyncedon": "@utcNow()"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Get_product_by_barcode": [
                  "Succeeded"
                ]
              }
            }
          },
          "else": {
            "actions": {}
          },
          "runAfter": {}
        }
      }
    },
    "templateName": null,
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "lab_sharedcommondataserviceforapps"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      },
      "lab_connectorsopenfoodfacts": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "lab_openfoodfacts"
        },
        "api": {
          "name": "lab_connectorsopenfoodfacts"
        }
      }
    }
  },
  "schemaVersion": "1.0.0.0"
}
